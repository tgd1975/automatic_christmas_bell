{
  "about": "Scenarios for `edakit sim`: USB supply at the T-Display's 5V pin x load x LED forward-voltage corners. Values with 'note' are assumptions.",
  "ambient_c": 30,
  "sources": {
    "U1": {
      "plus": "1",
      "minus": "2",
      "r_ohm": 0.4,
      "i_max_a": 1.0,
      "i_min_a": 0.1,
      "note": "5V pin of the T-Display: USB minus its 1N5819 (1 A); 0.4 ohm for cable and diode; power banks switch off below about 50-100 mA - 100 mA assumed (D-8)"
    }
  },
  "supplies": {
    "usb-min": {
      "U1": 4.35,
      "note": "4.75 V USB minus 0.4 V (1N5819 at 0.5 A)"
    },
    "usb-nom": {
      "U1": 4.65
    },
    "usb-max": {
      "U1": 5.0,
      "note": "5.25 V USB minus 0.25 V diode at low current"
    }
  },
  "loads": {
    "idle": {
      "about": "countdown off, servo holds the middle",
      "gpio": {},
      "leds_on": [],
      "external": {
        "J1": {
          "plus": "2",
          "minus": "1",
          "i_a": 0.01,
          "note": "servo at rest"
        }
      }
    },
    "countdown": {
      "about": "first green LED on, start pressed",
      "gpio": {
        "LED_G1": 1
      },
      "leds_on": [
        "LED5"
      ],
      "buttons": [
        "S1"
      ],
      "external": {
        "J1": {
          "plus": "2",
          "minus": "1",
          "i_a": 0.01
        }
      }
    },
    "warning": {
      "about": "final warning: all LEDs on, reset pressed",
      "gpio": {
        "LED_G1": 1,
        "LED_G2": 1,
        "LED_Y1": 1,
        "LED_Y2": 1,
        "LED_R": 1
      },
      "leds_on": "all",
      "buttons": [
        "S2"
      ],
      "external": {
        "J1": {
          "plus": "2",
          "minus": "1",
          "i_a": 0.01
        }
      }
    },
    "bell": {
      "about": "servo swings the bell, LEDs off",
      "gpio": {},
      "leds_on": [],
      "external": {
        "J1": {
          "plus": "2",
          "minus": "1",
          "i_a": 0.3,
          "note": "9 g servo under load 0.2-0.3 A (assumption)"
        }
      }
    },
    "servo-stalled": {
      "about": "servo stalled (bell stuck), LEDs off",
      "gpio": {},
      "leds_on": [],
      "external": {
        "J1": {
          "plus": "2",
          "minus": "1",
          "i_a": 0.7,
          "note": "stall current of a 9 g servo 0.6-0.75 A (assumption)"
        }
      },
      "matrix": false
    }
  },
  "corners": [
    "min",
    "max"
  ],
  "mcu": {
    "U1": {
      "outputs": [
        "LED_G1",
        "LED_G2",
        "LED_Y1",
        "LED_Y2",
        "LED_R",
        "SERVO"
      ],
      "inputs": [
        "BTN_START",
        "BTN_RESET"
      ]
    }
  },
  "derating": {
    "p": 0.5,
    "i": 0.8,
    "v_cap": 0.67,
    "v_diode": 0.67,
    "v_bjt": 0.67
  },
  "criteria": {
    "net_range_tol_v": 0.05,
    "led_on_min_a": 0.002,
    "led_off_max_a": 1e-05,
    "rail_tol": 0.03
  },
  "report": [
    "+5V",
    "BTN_START"
  ],
  "extra_scenarios": [
    {
      "name": "usb-nom/servo-stalled",
      "supply": {
        "U1": 4.65
      },
      "load": "servo-stalled",
      "info": true,
      "note": "fault case: a stalled servo draws about 0.7 A through the module's 1N5819 (1 A average) – like D-3 on the Nano, the firmware should detach the servo at rest"
    }
  ]
}
